# yt-Agent (TubePilot AI) — corrected .env.example
# LOCAL PRODUCTION PATCH, 25 Nov 2026. Pinned commit c39f42541b8e784dcf41c09583dc57227be07667
# Changes vs original:
# - AWS_REGION is the single source of truth: us-east-2 (confirmed by user 25 Nov 2026).
#   Do NOT use ap-southeast-2 (old .env.example) or us-east-1 (old setup_dynamo.py).
# - LLM: Gemini AI Studio (free) + OpenRouter only. NO Bedrock (user decision 25 Nov 2026).
# - Added YT_REFRESH_TOKEN (required for YouTube upload, was README-only).
# - Added GEMINI_KEY_POOL / GEMINI_KEY_1..20 (README multi-key failover).
# - Never put real secrets in this file. Copy to .env in Codespace and fill real values there,
#   or store them via the bot's /keys set flow (DynamoDB, Fernet-encrypted).

# === MASTER SECRET (for encrypting API keys in DynamoDB) ===
MASTER_SECRET=

# === AWS (DynamoDB in us-east-2 & Polly TTS; Bedrock NOT used) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# === LLM Providers — Gemini (free, primary) + OpenRouter (fallback) ===
GEMINI_KEY=
GEMINI_KEY_POOL=
# GEMINI_KEY_1=
# GEMINI_KEY_2=
OPENROUTER_KEY=

# === Media ===
# === Media — Agnes AI (free Angel Trial, Flash models) ===
# Existing key in the Agnes account is named "mus" (created 25 Nov 2026).
# Store its value as a Codespaces secret; never paste it here.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# Image model: agnes-image-2.5-flash (POST /v1/images/generations)
# Video model: agnes-video-2.5-flash (POST /v1/videos, async poll, 5-10s)
# Set to 1 to make Agnes the default image provider in tools/image_gen.py
# (otherwise pass model="agnes/agnes-image-2.5-flash" explicitly).
AGNES_AS_DEFAULT_IMAGE_PROVIDER=
# Video poll defaults (see tools/agnes_ai.py): seconds / interval
AGNES_VIDEO_POLL_TIMEOUT_SEC=600
AGNES_VIDEO_POLL_INTERVAL_SEC=10
PIXABAY_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=

# === YouTube — OAuth2 (real OAuth, not API-key-as-secret) ===
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# === GitHub (for Actions dispatch) ===
GH_PAT=
GH_REPO_OWNER=alphaframehq
GH_REPO_NAME=yt-Agent

# === Research ===
TINYFISH_API_KEY=
